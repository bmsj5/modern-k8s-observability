          "editorMode": "code",
          "format": 1,
          "query": "SELECT * FROM ${app} WHERE time_range(_timestamp, '${__from:date:iso}', '${__to:date:iso}') AND ( ('${trace_id:text}' != '' AND (trace_id = '${trace_id:text}' OR trace_id = lower('${trace_id:text}'))) OR ('${trace_id:text}' = '' AND region IN ([[region:singlequote]]) AND cluster_id IN ([[cluster_id:singlequote]]) AND k8s_node_name IN ([[k8s_node_name:singlequote]]) AND k8s_pod_name IN ([[k8s_pod_name:singlequote]]) AND env IN ([[env:singlequote]]) AND severity IN ([[severity:singlequote]]) AND body LIKE '%$search_term%' ) ) ORDER BY _timestamp DESC LIMIT ${limit}",
          "rawQuery": true,
          "rawSql": "SELECT *\nFROM ${app}\nWHERE time_range(_timestamp, '${__from:date:iso}', '${__to:date:iso}')\n  AND (\n    ('${trace_id:text}' != '' AND (trace_id = '${trace_id:text}' OR trace_id = lower('${trace_id:text}')))\n    OR\n    ('${trace_id:text}' = ''\n      AND region IN ([[region:singlequote]])\n      AND cluster_id IN ([[cluster_id:singlequote]])\n      AND k8s_node_name IN ([[k8s_node_name:singlequote]])\n      AND k8s_pod_name IN ([[k8s_pod_name:singlequote]])\n      AND env IN ([[env:singlequote]])\n      AND severity IN ([[severity:singlequote]])\n      AND body LIKE '%$search_term%'\n    )\n  )\nORDER BY _timestamp DESC\nLIMIT ${limit}",
